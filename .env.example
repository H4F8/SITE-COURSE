# ============================================
# News Parser API — настройки
# Скопируй этот файл в .env и отредактируй под себя:
#   cp .env.example .env
# ============================================

# --- Локальная ИИ ---
# Провайдер: "ollama" (по умолчанию) или "openai" (LM Studio / любой OpenAI-совместимый сервер)
AI_PROVIDER=ollama

# Для Ollama (по умолчанию http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Для LM Studio / OpenAI-совместимых серверов
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio

# Модель (для Ollama: ollama list — посмотреть доступные)
AI_MODEL=llama3.2

# Параметры генерации
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=512
AI_TIMEOUT=60.0

# --- Парсинг новостей ---
# RSS-ленты по умолчанию (через запятую)
DEFAULT_FEEDS=https://lenta.ru/rss,https://www.rbc.ru/rss/,https://news.yandex.ru/index.rss

# Максимум статей с одной ленты
MAX_ARTICLES_PER_FEED=20

# Максимум статей для суммаризации за раз
MAX_SUMMARIZE_BATCH=5

# --- Хранилище ---
STORAGE_FILE=news_storage.json